        "booklets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "codes": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "pattern": "^([a-z\\d-]+:[a-z\\d-]+,?\\W?)+$"
              }
            },
            "additionalProperties": false
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "assetAssignments": {
          "$ref": "#/$defs/assetAssignments"
        },
        "viewSettings": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string"
            },
            "codeInput": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text-field",
                    "keypad-symbols",
                    "keypad-symbols-alt",
                    "keypad-numbers"
                  ]
                },
                "length": {
                  "type": "integer",
                  "minimum": 3
                }
              },
              "additionalProperties": false
            },
            "monitorBookletVisibility": {
              "type": "string",
              "enum": [
                "visible",
                "collapsed",
                "hidden"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
