        },
        "gm_selection_text_expired": {
          "type": "string",
          "description": "Der Text im Button bei Auswahl der Testleitungskonsole, wenn die Gruppe abgelaufen ist. $date wird gegen das Ablaufdatum ersetzt."
        },
        "gm_selection_text_scheduled": {
          "type": "string",
          "description": "Der Text im Button bei Auswahl der Testleitungskonsole, wenn die noch nicht freigegeben abgelaufen ist. $date wird gegen das Freigabedatum ersetzt."
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "properties": {
        "groupMonitor": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/profile"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "login"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "validFrom": {
            "type": "string",
            "pattern": "^\\d{1,2}/\\d{1,2}/\\d{2,4}\\W\\d{1,2}:\\d{2}$"
          },
          "validTo": {
            "type": "string",
            "pattern": "^\\d{1,2}/\\d{1,2}/\\d{2,4}\\W\\d{1,2}:\\d{2}$"
          },
          "validFor": {
            "type": "integer"
          },
          "assetAssignments": {
            "$ref": "#/$defs/assetAssignments"
          },
          "login": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/login"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "modeConfig": {
      "type": "object",
      "title": "Modus-Konfiguration",
      "properties": {
        "alwaysNewSession": {
          "type": "boolean",
          "description": "Erzwingt bei jedem Login eine frische Sitzung."
        },
        "monitorable": {
          "type": "boolean",
          "description": "Bestimmt, ob der Test im Gruppenmonitor sichtbar ist."
        },
        "canReview": {
          "type": "boolean",
          "description": "Erlaubt die Verwendung der Review-Funktion."
        },
        "saveResponses": {
          "type": "boolean",
          "description": "Speichert die Antworteingaben in der Datenbank."
        },
        "forceTimeRestrictions": {
          "type": "boolean",
          "description": "Setzt Zeitbeschränkungen durch."
        },
        "forceNaviRestrictions": {
          "type": "boolean",
          "description": "Erzwingt Navigations-Einschränkungen."
        },
        "showCode": {
          "type": "boolean",
          "description": "Zeigt Log-in/Freigabe-Codes an."
        },
        "showTimeLeft": {
          "type": "boolean",
          "description": "Blendet die verbleibende Bearbeitungszeit ein."
        },
        "showUnitMenu": {
          "type": "boolean",
          "description": "Aktiviert die Aufgabenübersicht/Navigationsmenü."
        },
        "receiveRemoteCommands": {
          "type": "boolean",
          "description": "Empfängt Steuerungsbefehle über den Monitor."
        },
        "canChangeStateOptions": {
          "type": "boolean",
          "description": "Erlaubt das Ändern von Zustandsoptionen."
        }
      },
      "additionalProperties": false
    },
    "assetAssignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Mapping von Slot-Namen auf Dateipfade"
    },
    "login": {
      "type": "object",
      "required": [
        "name",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "pw": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "description": "Durchführungsmodus für den Login",
          "oneOf": [
            {
              "const": "run-demo",
              "title": "run-demo",
              "description": "Modus für Vorführungen ohne Speicherung",
              "properties": {
                "config": {
                  "$ref": "#/$defs/modeConfig",
                  "type": "object",
                  "title": "Modus-Konfiguration",
                  "properties": {
                    "alwaysNewSession": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/alwaysNewSession"},
                    "monitorable": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/monitorable"},
                    "canReview": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/canReview"},
                    "saveResponses": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/saveResponses"},
                    "forceTimeRestrictions": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/forceTimeRestrictions"},
                    "forceNaviRestrictions": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/forceNaviRestrictions"},
                    "showCode": { "type": "boolean", "default": true, "$ref": "#/$defs/modeConfig/properties/showCode"},
                    "showTimeLeft": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/showTimeLeft"},
                    "showUnitMenu": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/showUnitMenu"},
                    "receiveRemoteCommands": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/receiveRemoteCommands"},
                    "canChangeStateOptions": { "type": "boolean", "default": true, "$ref": "#/$defs/modeConfig/properties/canChangeStateOptions"}
                  }
                }
              }
            },
            {
              "const": "monitor-group",
              "title": "monitor-group",
              "description": "Modus für die Gruppenüberwachung im Demo-Modus",
              "properties": {
                "config": {
                  "type": "object",
                  "title": "Modus-Konfiguration",
                  "properties": {
                    "alwaysNewSession": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/alwaysNewSession"},
                    "monitorable": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/monitorable"},
                    "canReview": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/canReview"},
                    "saveResponses": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/saveResponses"},
                    "forceTimeRestrictions": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/forceTimeRestrictions"},
                    "forceNaviRestrictions": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/forceNaviRestrictions"},
                    "showCode": { "type": "boolean", "default": true, "$ref": "#/$defs/modeConfig/properties/showCode"},
                    "showTimeLeft": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/showTimeLeft"},
                    "showUnitMenu": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/showUnitMenu"},
                    "receiveRemoteCommands": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/receiveRemoteCommands"},
                    "canChangeStateOptions": { "type": "boolean", "default": true, "$ref": "#/$defs/modeConfig/properties/canChangeStateOptions"}
                  }
                }
              }
            },
            {
              "const": "monitor-study",
              "title": "monitor-study",
              "description": "Modus für die Studienüberwachung im Demo-Modus",
              "properties": {
                "config": {
                  "type": "object",
                  "title": "Modus-Konfiguration",
                  "properties": {
                    "alwaysNewSession": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/alwaysNewSession"},
                    "monitorable": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/monitorable"},
                    "canReview": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/canReview"},
                    "saveResponses": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/saveResponses"},
                    "forceTimeRestrictions": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/forceTimeRestrictions"},
                    "forceNaviRestrictions": { "type": "boolean", "default": false, "$ref": "#/$defs/modeConfig/properties/forceNaviRestrictions"},
                    "showCode": { "type": "boolean", "default": true, "$ref": "#/$defs/modeConfig/properties/showCode"},
