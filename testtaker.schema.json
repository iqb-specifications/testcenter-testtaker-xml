{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Testtaker Schema 18.0",
  "schema_version": "18.0",  
  "description": "Schema Testtaker-json",
  "type": "object",
  "required": [
    "metadata",
    "group"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "customTexts": {
      "type": "object",
      "description": "Key-Value Paare für benutzerdefinierte Texte",
