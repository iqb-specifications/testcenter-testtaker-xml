        "gm_multiple_booklet_species_warning": {
          "type": "string",
          "description": "Tooltip über dem 'Immer alle Auswählen'-Schalter, der erscheint, wenn dieser deaktiviert ist"
        },
        "gm_auto_checkall": {
          "type": "string",
          "description": "Der 'Immer alle Auswählen'-Schalter"
        },
        "gm_selection_text": {
