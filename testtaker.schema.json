      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "blockColumn": {
          "type": "string",
          "enum": ["show", "hide"]
        },
        "unitColumn": {
          "type": "string",
          "enum": ["show", "hide"]
        },
        "groupColumn": {
          "type": "string",
          "enum": ["show", "hide"]
        },
        "bookletColumn": {
          "type": "string",
          "enum": ["show", "hide"]
        },
        "bookletStatesColumns": {
          "type": "string"
        },
        "view": {
          "type": "string",
          "enum": ["full", "medium", "small"]
        },
        "filterPending": {
          "type": "string",
          "enum": ["yes", "no"]
        },
        "filterLocked": {
          "type": "string",
          "enum": ["yes", "no"]
        },
        "autoselectNextBlock": {
          "type": "string",
          "enum": ["yes", "no"]
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "field": {
                "type": "string",
                "enum": [
                  "bookletLabel",
                  "personLabel",
                  "state",
                  "blockLabel",
                  "groupName",
                  "bookletId",
                  "unitId",
                  "unitLabel",
                  "blockId",
                  "testState",
                  "mode",
                  "bookletSpecies",
                  "bookletStates"
                ]
              },
              "type": {
                "type": "string",
                "enum": ["equal", "substring", "regex"]
              },
              "value": {
                "type": "string"
              },
              "subValue": {
                "type": "string"
              },
              "not": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
